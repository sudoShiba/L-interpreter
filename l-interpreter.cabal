cabal-version:      3.0
name:               l-interpreter
version:            0.1.0.0
build-type:         Simple

library
    exposed-modules:  Types, Parser, Interpreter
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:
        base >= 4.7 && < 5,
        containers,
        megaparsec >= 9.0

executable l-wasm
  main-is:          Wasm.hs
  other-modules:    Types, Parser, Interpreter
  hs-source-dirs:   src
  default-language: Haskell2010
  build-depends:
      base >= 4.14 && < 5,
      containers,
      megaparsec >= 9.0
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_init,--export=runTraceWasm,--export=malloc,--export=free"

